{
  "name": "pagehub-demos",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable example integrations of the @pagehub/sdk page builder across stacks.",
  "scripts": {
    "dev:vanilla": "pnpm --filter @pagehub-demos/vanilla-html dev",
    "dev:vite": "pnpm --filter @pagehub-demos/vite-react dev",
    "dev:next": "pnpm --filter @pagehub-demos/nextjs dev",
    "build": "pnpm -r --filter ./vite-react --filter ./nextjs build",
    "typecheck": "pnpm -r --filter ./vite-react --filter ./nextjs typecheck"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.18"
  }
}
